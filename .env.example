# Supabase project. For local development, `supabase status` prints both values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps Platform (Maps JavaScript API + Places API (New)).
# A browser key: restrict it by HTTP referrer (http://localhost:3000/*) and to
# those APIs (plus Routes API, for travel times) in Google Cloud. It ships to the browser, so never use an
# unrestricted key here. Without it the Map page and place search show a notice.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for Advanced Markers. "DEMO_MAP_ID" works in development; create your
# own in Google Cloud (Map Management) for production styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Anthropic API key for the AI ideas in free time (server only: no NEXT_PUBLIC_).
# Optional: without it the "¿Qué hago?" buttons don't show. Each trip's owner
# still has to turn the ideas on in Editar viaje.
ANTHROPIC_API_KEY=

# Server only (no NEXT_PUBLIC_): the Supabase secret key. Bypasses RLS, so it's
# used in one place, src/lib/supabase/admin.ts, for what has no signed-in user:
# reading recipients' emails and sending notification emails. Locally it's the
# SECRET_KEY that `supabase status` prints; in production, the project's secret key.
SUPABASE_SECRET_KEY=

# Emails (Resend). Without a verified domain Resend only delivers to your own
# account's address, from onboarding@resend.dev. Without a key, emails are only
# logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="Travio <onboarding@resend.dev>"
# Public URL used in email links when there's no request (scheduled emails).
# On Vercel it falls back to the production domain.
APP_URL=http://localhost:3000
# Shared secret for the notification job (/api/avisos/enviar), called by
# pg_cron. The same value goes in Supabase Vault as "notifications_secret",
# next to "notifications_url" (README, "Avisos por correo").
CRON_SECRET=
