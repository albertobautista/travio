# Supabase project. For local development, `supabase status` prints both values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps Platform (Maps JavaScript API + Places API (New)).
# A browser key: restrict it by HTTP referrer (http://localhost:3000/*) and to
# those two APIs in Google Cloud. It ships to the browser, so never use an
# unrestricted key here. Without it the Map page and place search show a notice.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for Advanced Markers. "DEMO_MAP_ID" works in development; create your
# own in Google Cloud (Map Management) for production styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
